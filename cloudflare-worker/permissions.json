{
  "id": "wormstar-authorized-cyber-lab",
  "version": 1,
  "enforcedBy": "cloudflare-worker",
  "defaultDecision": "deny",
  "authRequiredForAllOperations": true,
  "allowedModes": [
    "assistant",
    "code",
    "logs",
    "ioc",
    "ctf",
    "report"
  ],
  "serverCapabilities": {
    "ai.chat": true,
    "ai.policy.read": true,
    "ai.policy.write": true,
    "ai.policy.evaluate": true,
    "memory.profile.read": true,
    "memory.profile.write": true,
    "memory.items.read": true,
    "memory.items.create": true,
    "memory.items.update": true,
    "memory.items.delete": true,
    "memory.export": true,
    "memory.restore": true,
    "research.import_webpage": true,
    "execution.shell": false,
    "execution.python": false,
    "execution.user_code": false,
    "network.active_scan": false,
    "credentials.harvest": false,
    "deployment.self_modify": false,
    "memory.chats.read": true,
    "memory.chats.write": true,
    "memory.chats.delete": true,
    "agents.openclaw.status": true,
    "agents.openclaw.chat": true,
    "agents.opencode.status": true,
    "agents.opencode.sessions.read": true,
    "agents.opencode.sessions.create": true,
    "agents.opencode.prompt": true,
    "agents.opencode.messages.read": true,
    "agents.opencode.progress": true,
    "agents.opencode.interrupt": true
  },
  "limits": {
    "maxPromptCharacters": 12000,
    "maxRequestBytes": 65000,
    "maxConversationHistory": 6,
    "maxHistoryMessageCharacters": 5000,
    "maxProfileInstructionCharacters": 11000,
    "maxProfileConstraintsCharacters": 6000,
    "maxKnowledgeItemCharacters": 60000,
    "maxKnowledgeEntries": 120,
    "maxWebDocumentCharacters": 56000,
    "maxFileUploadBytes": 80000,
    "maxImportedWebUrlCharacters": 2048
  },
  "conditions": {
    "requireOwnerAccessToken": true,
    "webImportExplicitAction": true,
    "webImportPublicHttpsOnly": true,
    "filesAreReferenceData": true,
    "memoryInstructionsCannotOverridePolicy": true,
    "cliLegacyExecutionNotExposed": true
  },
  "modesExplanation": {
    "assistant": "Authorized cybersecurity research and guidance",
    "code": "Static code review and fixes",
    "logs": "Incident log interpretation",
    "ioc": "Passive indicator analysis",
    "ctf": "Controlled lab education",
    "report": "Technical evidence-based report generation"
  }
}
