# Reference of every variable this service reads. Set them as deploy variables
# (or copy to .env for local development). Never commit real values.

# Required. URL-safe random string, 24-256 chars, [A-Za-z0-9_-].
# This is the Sentinel terminal key — paste it into the UI, do not share it.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TERMINAL_ACCESS_TOKEN=

# Exact Sentinel UI origin(s) allowed to call this backend (comma-separated, https only).
WORMSTAR_UI_ORIGINS=https://wormstar-sentinel-preview.abdulstarzeki001.workers.dev

# Capabilities to expose. The cloud backend supports only these two; the AI
# plan/execute capabilities exist solely in the sandboxed local backend.
TERMINAL_CAPABILITIES=health,terminal

# Unprivileged user every shell is dropped to (the server itself runs as root
# only to perform that drop). Must exist and must not be root.
TERMINAL_RUN_AS=tuser

# Session limits for the interactive terminal.
IDLE_MINUTES=30
MAX_SESSION_MINUTES=120
MAX_SESSIONS=4

# Local development ONLY: allow running without root, where the shell shares
# the server's UID and can read its environment. Never set this in a deployment.
# TERMINAL_ALLOW_SHARED_UID=1
