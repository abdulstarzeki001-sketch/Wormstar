# This file is a template. Never commit actual API keys or tunnel tokens.
# Absolute path on the GPU server, containing gpt-oss-120b/ and/or gpt-oss-20b/.
MODEL_ROOT=/opt/wormstar-gptoss/models

# Choose one per GPU server. Use 120b for the full 120B model.
MODEL_VARIANT=gpt-oss-120b
MAX_MODEL_LEN=32768

# Pin an approved container image version/digest before production deployment.
VLLM_IMAGE=vllm/vllm-openai:latest

# Create with: openssl rand -hex 32
GPU_API_TOKEN=REPLACE_WITH_RANDOM_64_HEX_CHAR_SECRET

# Optional Cloudflare Tunnel token. Configure Access service-token policy first.
CF_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
